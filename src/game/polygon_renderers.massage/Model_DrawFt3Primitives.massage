-addu $t0, $t0, $s7
-lw $t0, 0x0($t0)
+srl $t0, $t0, 1
+addu $v1, $t0, $s7
+lw $t0, 0x0($v1)
 sw $t0, 0x4($t9)
@@ -99,2 +100,3 @@
 addu $v0, $v0, $t7
+lw $t5, 0x0($v0)
 swc2 $12, 0x8($t9)
@@ -102,3 +104,2 @@
