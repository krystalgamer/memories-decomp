-lw $t5, 0x0($v0)
 .L4:
@@ -133,3 +134,3 @@
 sw $v1, 0x38($t9)
-sw $s0, 0x24($t9)
+sw $t4, 0x24($t9)
 addiu $t9, $t9, 0x20
