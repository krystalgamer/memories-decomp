# Model_DrawFt3Primitives: massage of its plain C in src/game/polygon_renderers.c.
function = Model_DrawFt3Primitives
source = src/game/polygon_renderers.c
address = 0x800612C0
size = 0x25C
rules = strip-nops aligned-word-copy dmpsx-native gte-direct-read gte-direct-write unspill invariant-last fold-address undo-strength-reduction word-compose halfword-words tag-build loop-load-forwarding at-constants at-branch-constants sign-extend-load zero-extend-shifts reuse-load zero-as-addiu increment-sink loop-constant store-delay-slot gte-load-early dce drop-self-moves frameless guard-chain preheader-order fill-load-delay fill-branch-slot fill-jump-slot
frameless = $a0 0x20

[registers]
$v0.1 = $a3       # lw $v0.1, 0x0($s4.1)
$v0.2 = $a2       # lw $v0.2, 0x4($v0.1)
$v0.4 = $s6       # lui $v0.4, %hi(gModel_bCurrentDrawMode)
$v0.8 = $t7       # lw $v0.8, 0x4($s4.1)
$v0.10 = $t5      # srl $v0.10, %word1, 16
$v0.13 = $t5      # sll $v0.13, %word2, 16
$v0.16 = $t5      # srl $v0.16, %word2, 16
$v0.19 = $t0      # sll $v0.19, %word1, 16
$v0.24 = $t0      # srl $v0.24, $a1.1, 1
$v0.25 = $t5      # addu $v0.25, $v1.2, $s6.1
$v0.26 = $t0      # srl $v0.26, $v1.2, 1
$v0.43 = $t1      # and $v0.43, $a2.2, $at
$v0.44 = $t0      # sll $v0.44, $t2.1, 16
$v1.1 = $a1       # lw $v1.1, 0x14($s4.1)
$v1.2 = $t0       # srl $v1.2, $v0.19, 13
$a0.0 = $a0     
$a1.1 = $t0       # addu $a1.1, $v1.2, $zero
$a2.1 = $t1       # lw $a2.1, 0x4($t8.1)
$a3.1 = $t9       # lw $a3.1, 0x10($s4.1)
$t0.1 = $v0       # addu $t0.1, $v0.35, $v0.9
$t1.1 = $v1       # and $t1.1, $t7.2, $at
$t2.1 = $t0       # lw $t2.1, 0x0($t8.1)
$t7.1 = $s0       # lui $t7.1, %hi(gModel_dwPolyFt3Template)
$s0.1 = $s3       # srl $s0.1, $t7.2, 24
$s0.2 = $t6       # lw $s0.2, 0x8($s4.1)
$s1.1 = $a1       # lw $s1.1, 0x18($s4.1)
$s2.1 = $s7       # lui $s2.1, %hi(gModel_dwLitColorCacheBase)
$s3.1 = $s2       # lui $s3.1, %hi(gModel_dwSecondPassClutBits)
$s4.1 = $a0       # addu $s4.1, $a0.0, $zero
$s5.1 = $s1       # lui $s5.1, %hi(gModel_dwTpageBlendRateBits)
$s5.7 = $v1       # lw $s5.7, 0x8($a3.1)
$s5.9 = $v1       # lw $s5.9, 0x10($a3.1)
$s5.11 = $v1      # lw $s5.11, 0x18($a3.1)
$s6.1 = $a2       # lw $s6.1, 0x1C($s4.1)
$s6.3 = $t2       # lw $s6.3, 0x8($t8.1)
$t8.1 = $a3       # addu $t8.1, $v1.1, $v0.3
$t9.1 = $t8       # lhu $t9.1, 0x2($v0.1)
%tag1 = $t5       # lw %tag1, 0x0($t0.1)
%word1 = $t0      # lw %word1, 0xC($t8.1)
%word2 = $t1      # lw %word2, 0x10($t8.1)

[residual]
--- rules
+++ retail
@@ -16,3 +16,2 @@
 lw $s0, %lo(gModel_dwPolyFt3Template)($s0)
-mtc2 $s0, $6
 lui $s1, %hi(gModel_dwTpageBlendRateBits)
@@ -25,8 +24,10 @@
 lw $s7, %lo(gModel_dwLitColorCacheBase)($s7)
+addu $t4, $s0, $zero
 srl $s3, $s0, 24
+lw $a1, 0x18($a0)
 lw $a2, 0x1C($a0)
-lw $a1, 0x18($a0)
-lw $t7, 0x4($a0)
+mtc2 $s0, $6
+lw $t5, 0x4($a0)
 lw $t6, 0x8($a0)
-lw $t7, 0x4($t7)
+lw $t7, 0x4($t5)
 .L9:
@@ -65,3 +66,2 @@
