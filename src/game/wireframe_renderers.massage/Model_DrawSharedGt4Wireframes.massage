# Model_DrawSharedGt4Wireframes: massage of its plain C in src/game/wireframe_renderers.c.
function = Model_DrawSharedGt4Wireframes
source = src/game/wireframe_renderers.c
address = 0x8006AAFC
size = 0x18C
rules = strip-nops aligned-word-copy dmpsx-native gte-direct-read gte-direct-write unspill invariant-last fold-address undo-strength-reduction word-compose halfword-words tag-build loop-load-forwarding at-constants at-branch-constants sign-extend-load zero-extend-shifts reuse-load zero-as-addiu increment-sink loop-constant store-delay-slot gte-load-early rotate-loop-loads dce drop-self-moves frameless guard-chain preheader-order fill-load-delay fill-branch-slot fill-jump-slot
frameless = $a0 0x28

[registers]
$v0.1 = $a3       # lw $v0.1, 0x0($t9.1)
$v0.2 = $a2       # lw $v0.2, 0x4($v0.1)
$v0.8 = $t5       # lw $v0.8, 0x4($t9.1)
$v0.9 = $t5       # srl $v0.9, %word1, 16
$v0.13 = $t5      # srl $v0.13, %word2, 16
$v0.16 = $t5      # srl $v0.16, %word3, 16
$v0.19 = $t5      # srl $v0.19, %word4, 16
$v1.1 = $a1       # lw $v1.1, 0x14($t9.1)
$v1.11 = $v0      # lw $v1.11, 0x4($a1.2)
$v1.12 = $v0      # mfc2 $v1.12, $7
$a0.0 = $a0     
$a0.4 = $t5       # lui $a0.4, %hi(gModel_bCurrentDrawMode)
$a0.5 = $t5       # addu $a0.5, $v0.10, $t2.1
$a0.8 = $v0       # lw $a0.8, 0x4($v0.18)
$a1.1 = $a3       # addu $a1.1, $v1.1, $v0.3
$a1.2 = $t5       # addu $a1.2, $v0.20, $t2.1
$a3.1 = $v0       # lw $a3.1, 0x4($v0.15)
$t1.1 = $t9       # lw $t1.1, 0x10($t9.1)
$t2.1 = $a1       # lw $t2.1, 0x1C($t9.1)
$t3.1 = $v0       # lw $t3.1, 0x4($a0.5)
$t4.1 = $t8       # lhu $t4.1, 0x2($v0.1)
$t6.1 = $v1       # addiu $t6.1, $zero, -0x1
$t7.1 = $s0       # lui $t7.1, %hi(gModel_dwLineF3Template)
$s1.1 = $t7       # lw $s1.1, 0x4($v0.8)
$s2.1 = $t6       # lw $s2.1, 0x8($t9.1)
$s3.1 = $s1       # lui $s3.1, %hi(gModel_dwDrawModeTemplate)
$s4.2 = $t5       # lw $s4.2, 0x0($a0.5)
$s4.6 = $t5       # lw $s4.6, 0x0($v0.15)
$s4.8 = $t5       # lw $s4.8, 0x0($v0.18)
$s4.10 = $t5      # lw $s4.10, 0x0($a1.2)
$t8.1 = $s2       # lui $t8.1, 0x5555
$t9.1 = $a0       # addu $t9.1, $a0.0, $zero
%tag1 = $t5       # lw %tag1, 0x0($v1.15)
%word1 = $t0      # lw %word1, 0xC($a1.1)
%word2 = $t1      # lw %word2, 0x10($a1.1)
%word3 = $t2      # lw %word3, 0x14($a1.1)
%word4 = $t3      # lw %word4, 0x18($a1.1)

[residual]
--- rules
+++ retail
@@ -23,2 +23,3 @@
 lw $a1, 0x1C($a0)
+lw $a2, 0x24($a0)
 lw $t5, 0x4($a0)
